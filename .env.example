# Modelo do arquivo .env. NÃO preencha à mão: rode
#   powershell -ExecutionPolicy Bypass -File scripts\gerar-env.ps1
# que copia este modelo para .env e troca cada __GERAR__ por um valor aleatório.
# O arquivo .env nunca deve ser enviado para o Git nem compartilhado.

# Fuso horário usado nos logs e no n8n.
FUSO_HORARIO=America/Sao_Paulo

# Portas locais (publicadas somente em 127.0.0.1).
WAHA_PORT=3000
N8N_PORT=5678
PAINEL_PORT=8080

# Chave da API do WAHA (enviada pelo n8n e pelos scripts no cabeçalho X-Api-Key).
WAHA_API_KEY=__GERAR__
# Hash SHA-512 da chave acima: é só isto que o contêiner do WAHA recebe.
WAHA_API_KEY_SHA512=__GERAR_SHA512_DA_WAHA_API_KEY__

# Login do dashboard do WAHA (http://localhost:3000/dashboard, so pelo tunel) e do Swagger do WAHA.
# Nao e o painel do projeto (porta 8080 / endereco online), que tem login proprio.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=__GERAR__

# Token que o WAHA envia ao webhook do n8n (cabeçalho X-Webhook-Token).
WEBHOOK_TOKEN=__GERAR__

# Senha do Redis (estado do chatbot; acessível só pela rede interna do Docker).
REDIS_PASSWORD=__GERAR__

# Senha do Postgres (banco do histórico de conversas e eventos, versões da configuração,
# usuários do painel e página Métricas). Só na rede interna do Docker: a porta do banco não é
# publicada. Gerada pelo scripts\gerar-env.ps1 (32 caracteres, letras e números).
# NÃO troque depois da primeira subida: o volume do banco já foi criado com esta senha.
# Para trocar de verdade, é preciso alterar aqui e também dentro do banco.
POSTGRES_SENHA=__GERAR_SENHA_BANCO__

# Chave que criptografa as credenciais guardadas pelo n8n.
# Se for trocada depois da primeira subida, o n8n não consegue mais ler as credenciais.
N8N_ENCRYPTION_KEY=__GERAR__

# Dias que os arquivos de log (pasta logs/) são mantidos.
LOG_RETENCAO_DIAS=30

# Dias que as conversas (texto recebido e resposta enviada, vistas no painel em
# http://localhost:8080/conversas) ficam gravadas neste computador. De 1 a 30.
CONVERSAS_RETENCAO_DIAS=7

# Dias que as mensagens (conversas e eventos do bot) ficam guardadas no banco, para o histórico
# pesquisável e a página Métricas. Padrão 180. Registros e erros ficam no banco por 90 dias.
# Os arquivos de log continuam com a retenção de CONVERSAS_RETENCAO_DIAS.
# HISTORICO_RETENCAO_DIAS=180

# OPCIONAL: chave da API de IA usada quando o robô não entende a mensagem.
# Não preencha à mão: rode
#   powershell -ExecutionPolicy Bypass -File scripts\configurar-ia.ps1
# que grava a chave aqui, testa a conexão e liga a IA.
# Chave gratuita da Groq (começa com gsk_): https://console.groq.com/keys
IA_API_KEY=

# OPCIONAL: imagem do WAHA. Vazio = a padrao (amd64, PC comum). Em servidor ARM64 (VPS da
# Oracle) use a tag ARM; o scripts\vps.ps1 -Enviar grava esta linha sozinho no .env do servidor.
# WAHA_IMAGEM=gows-arm-2026.10.1

# --- Painel online (HTTPS e login) ---------------------------------------------------------
# Só no .env do SERVIDOR. Não preencha à mão: o scripts\vps.ps1 grava estas linhas.
#   -Online -Dominio <dominio>   grava PAINEL_DOMINIO, COMPOSE_PROFILES=online e PAINEL_CONFIAR_PROXY=true
#   -SenhaPainel                 grava PAINEL_USUARIO e PAINEL_SENHA_HASH (a senha nunca vai para o arquivo)
# No PC deixe tudo comentado/vazio: o painel fica só em localhost e sem login.
# Domínio do painel (ex.: <DOMINIO_DO_PAINEL>). Com domínio, o painel só sobe com senha.
# PAINEL_DOMINIO=
# Usuário do login do painel.
# PAINEL_USUARIO=admin
# Hash da senha (formato scrypt, sem '$'). NÃO é a senha: gerado por vps.ps1 -SenhaPainel.
# PAINEL_SENHA_HASH=
# true só atrás do Caddy (confia no cabeçalho X-Forwarded-For para o IP do visitante).
# PAINEL_CONFIAR_PROXY=false
# Perfis do docker compose. Vazio no PC; "online" no servidor liga o Caddy (HTTPS).
# COMPOSE_PROFILES=
