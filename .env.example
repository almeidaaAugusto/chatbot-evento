# Modelo do arquivo .env. NÃO preencha à mão: rode
#   powershell -ExecutionPolicy Bypass -File scripts\gerar-env.ps1
# que copia este modelo para .env e troca cada __GERAR__ por um valor aleatório.
# O arquivo .env nunca deve ser enviado para o Git nem compartilhado.

# Fuso horário usado nos logs e no n8n.
FUSO_HORARIO=America/Sao_Paulo

# Portas locais (publicadas somente em 127.0.0.1).
WAHA_PORT=3000
N8N_PORT=5678
PAINEL_PORT=8080

# Chave da API do WAHA (enviada pelo n8n e pelos scripts no cabeçalho X-Api-Key).
WAHA_API_KEY=__GERAR__
# Hash SHA-512 da chave acima: é só isto que o contêiner do WAHA recebe.
WAHA_API_KEY_SHA512=__GERAR_SHA512_DA_WAHA_API_KEY__

# Login do painel (http://localhost:3000/dashboard) e do Swagger do WAHA.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=__GERAR__

# Token que o WAHA envia ao webhook do n8n (cabeçalho X-Webhook-Token).
WEBHOOK_TOKEN=__GERAR__

# Senha do Redis (estado do chatbot; acessível só pela rede interna do Docker).
REDIS_PASSWORD=__GERAR__

# Chave que criptografa as credenciais guardadas pelo n8n.
# Se for trocada depois da primeira subida, o n8n não consegue mais ler as credenciais.
N8N_ENCRYPTION_KEY=__GERAR__

# Dias que os arquivos de log (pasta logs/) são mantidos.
LOG_RETENCAO_DIAS=30

# Dias que as conversas (texto recebido e resposta enviada, vistas no painel em
# http://localhost:8080/conversas) ficam gravadas neste computador. De 1 a 30.
CONVERSAS_RETENCAO_DIAS=7

# OPCIONAL: chave da API de IA usada quando o robô não entende a mensagem.
# Não preencha à mão: rode
#   powershell -ExecutionPolicy Bypass -File scripts\configurar-ia.ps1
# que grava a chave aqui, testa a conexão e liga a IA.
# Chave gratuita da Groq (começa com gsk_): https://console.groq.com/keys
IA_API_KEY=
